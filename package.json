{
  "name": "iconlens",
  "version": "0.2.0",
  "description": "Offline standalone-SVG accessibility linter. Computes accessible names per SVG-AAM and flags missing alt, dangling references and bad focus order.",
  "type": "module",
  "author": "srivtx",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/cli.ts"
  ],
  "private": true,
  "bin": {
    "iconlens": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "make-fixtures": "bun src/fixtures.ts",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "keywords": [
    "svg",
    "accessibility",
    "a11y",
    "lint",
    "linter",
    "wcag",
    "aria",
    "sarif",
    "code-scanning",
    "bun"
  ],
  "license": "MIT",
  "repository": "https://github.com/srivtx/iconlens",
  "homepage": "https://iconlens-srivtx.vercel.app",
  "bugs": {
    "url": "https://github.com/srivtx/iconlens/issues"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "src",
    "install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  }
}
